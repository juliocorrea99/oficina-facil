# Configuracoes de ambiente - Oficina Facil
# Copie este arquivo para .env no ambiente local e preencha os valores.
# ATENCAO: Nao envie o arquivo .env para o repositorio Git.

PORT=3000
NODE_ENV=development

# Banco de dados PostgreSQL
# Substituir pelos dados reais apenas no arquivo .env local:
DATABASE_URL=postgresql://SEU_USUARIO:SUA_SENHA@localhost:5432/oficina_facil

# Segredo para assinatura dos tokens JWT de autenticacao
JWT_SECRET=coloque_uma_chave_secreta_segura_aqui

# Tempo de expiracao do token JWT (ex: 24h, 7d)
JWT_EXPIRES_IN=24h
